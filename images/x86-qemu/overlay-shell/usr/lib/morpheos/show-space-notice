#!/bin/sh
# Show the notice the space guard staged in /run/morpheos/space-notice. The file is two lines:
# the message, then the colour name (`warn` or `ok`). `flow-notice` keeps the window up until a
# key or a click dismisses it, so the warning stays on the screen for a person to see.
set -eu

f=/run/morpheos/space-notice
[ -f "$f" ] || exit 0
message=$(sed -n '1p' "$f")
colour=$(sed -n '2p' "$f")
[ -n "$colour" ] || colour=warn
exec /usr/bin/flow-notice "$message" --colour "$colour"
