[Unit]
Description=The Wi-Fi picker (root, because joining a network needs NetworkManager's polkit check)
Documentation=https://github.com/robmitchellengineering-hub/MorpheOS/blob/main/docs/31-accounts.md
Requires=flow-shell.service NetworkManager.service
After=flow-shell.service NetworkManager.service
PartOf=flow-shell.service
OnFailure=getty@tty1.service

[Service]
Type=simple
# Root on purpose, and it is the only part of the desktop that is: NetworkManager authorises a non-root caller
# through polkit, and polkit is not in this image. A root client can still connect to the user's Wayland socket,
# because the socket's mode does not stop root.
User=root
Environment=XDG_RUNTIME_DIR=/run/flow
ExecStart=/usr/bin/flow-wifi
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
