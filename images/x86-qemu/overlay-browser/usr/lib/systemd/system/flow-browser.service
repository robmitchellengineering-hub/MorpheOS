[Unit]
Description=Firefox on the Flow shell (doc 20 E4)
Requires=flow-shell.service
After=flow-shell.service
# The system root is read-only. Firefox's profile and cache go on the data partition, but
# outside /home: Strata versions every file under /home, and a browser rewrites its profile
# databases and cache all the time, which would fill the store with nothing a person wrote.
# HOME stays in /home, so what a person downloads is versioned like their other files.
RequiresMountsFor=/home /persist

[Service]
Environment=XDG_RUNTIME_DIR=/run/flow WAYLAND_DISPLAY=wayland-0 MOZ_ENABLE_WAYLAND=1
Environment=HOME=/home/browser NO_AT_BRIDGE=1 XDG_CACHE_HOME=/persist/browser/cache
# The socket appears when the compositor has bound it; wait for it rather than guessing.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 300); do [ -S /run/flow/wayland-0 ] && exit 0; sleep 0.1; done; exit 1'
ExecStartPre=/bin/mkdir -p /home/browser /persist/browser/profile /persist/browser/cache
# The launch screen is the real Three.js animation (E19): Firefox shows login.html first;
# login.html redirects to start.html once the mesh has drawn and settled. (No --kiosk: kiosk
# mode blocks the redirect, and the window is what the boot test expects.)
ExecStart=/usr/bin/firefox --new-instance --profile /persist/browser/profile file:///usr/share/morpheos/login.html
# There is no launcher yet: a person who closes Firefox gets it back. A crash is not a clean
# exit, so it stays a failed unit, which the boot's health check sees.
Restart=on-success
RestartSec=1
StandardError=journal+console

[Install]
WantedBy=multi-user.target
