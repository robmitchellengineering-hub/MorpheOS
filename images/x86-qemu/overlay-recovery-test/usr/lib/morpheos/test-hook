#!/bin/sh
# Recovery test driver (S4, test images only). The harness writes the mode to the ESP
# before the first boot, and this walks it:
#   step 0 + mode "arm":  arm the recovery entry the way morph-boot arms a trial
#                         (`bootctl set-oneshot morpheos-recovery.conf`), step=1, reboot.
#   step 0 + mode "seed": seed a known set of files under /home and record their checksums
#                         on the ESP, step=1, power off (the harness then zeroes both slot
#                         partitions before the next run).
#   step 0 + mode "wipe": seed /home, then destroy BOTH slot partitions from inside the
#                         running machine (wipefs + zero the first 64 MiB) and force a
#                         reboot — the initramfs "way in" must arm recovery and heal, with
#                         every /home file surviving on the data partition.
#   step 1:               the machine has recovered into slot A; power off so the harness
#                         can read the disk.
set -eu
# The recovery driver has its OWN directory. Do not read MORPH_TEST_DIR here: the generic
# x86 overlay's morph-boot-check drop-in (10-esp.conf) sets MORPH_TEST_DIR=/efi/morph-test
# for the self-test drivers, and that would point this driver at an empty directory while
# the harness writes "arm"/"seed"/"wipe" to /efi/morph-recovery-test. The two must name the
# same place, so pin it.
dir=/efi/morph-recovery-test
mkdir -p "$dir"
step=$(cat "$dir/step" 2>/dev/null || echo 0)
say() { echo "morph-recovery-test: $*"; }
say "step $step"

# Seed a known set of files under /home and record their checksums on the ESP. Shared by
# "seed" (which then powers off) and "wipe" (which then destroys the system out from under
# them): the point of the wipe scenario is that the files are made, the system is lost, and
# they still come back.
seed_home() {
    say "seeding /home and recording checksums"
    mkdir -p /home/morph/Documents
    n=1
    while [ "$n" -le 24 ]; do
        awk -v n="$n" 'BEGIN { for (l=1; l<=40; l++) printf "recovery seed %04d line %02d\n", n, l }' \
            > "/home/morph/Documents/seed-$n.txt"
        n=$((n+1))
    done
    (cd /home/morph/Documents && find . -type f -name 'seed-*' | sort | xargs sha256sum) \
        > "$dir/before.sha256"
    sync
    say "$(wc -l < "$dir/before.sha256") files seeded"
}

# Destroy both slot partitions from inside the running machine, then force a reboot. The
# running root is one of the two partitions being wiped; Ubuntu 24.04's 6.8 kernel allows a
# root process to write a block device whose filesystem is mounted (CONFIG_BLK_DEV_WRITE_MOUNTED,
# default y) — that is the very thing this proves, not an assumption. `wipefs` removes the
# signature and the zeroing makes the partition read as empty, exactly what the harness-side
# wipe does with dd between runs.
wipe_slots() {
    say "wiping both slot partitions from inside the running machine"
    for part in root-a root-b; do
        wipefs -a "/dev/disk/by-partlabel/$part"
        dd if=/dev/zero of="/dev/disk/by-partlabel/$part" bs=1M count=64 conv=notrunc status=none
    done
    say "both slot partitions wiped; forcing a reboot"
    echo b > /proc/sysrq-trigger
    # Reached only if the magic sysrq did not fire (kernel.sysrq=0): force a reboot without
    # sync — the running root is already wiped, so a sync would be writing to a gone system.
    sleep 3
    reboot -f
}

case "$step" in
    0)
        mode=$(cat "$dir/mode" 2>/dev/null || echo arm)
        echo 1 > "$dir/step"; sync
        case "$mode" in
            arm)
                say "arming the recovery entry"
                bootctl --esp-path=/efi set-oneshot morpheos-recovery.conf
                say "rebooting into recovery"
                systemctl reboot
                ;;
            seed)
                seed_home
                systemctl poweroff
                ;;
            wipe)
                seed_home
                wipe_slots
                ;;
            *)
                say "unknown mode '$mode'"
                exit 1
                ;;
        esac
        ;;
    *)
        say "recovered; powering off for the harness"
        systemctl poweroff
        ;;
esac
