#!/bin/sh
# Self-test driver (test images only). Run by boot-check after each boot's
# health decision. Walks the update path by itself:
#   step 0: on the default slot, arm a trial of slot b and reboot into it
#   step 1: plain reboot, to prove whatever was decided has stuck
#   step 2: report the result, then finish
#
# MORPH_TEST_DIR     where the step counter lives (shared by both slots)
# MORPH_TEST_EXPECT  slot that should be the default at the end (optional)
# MORPH_TEST_FINISH  poweroff (VM tests) or stay (real hardware)
set -eu
dir=${MORPH_TEST_DIR:-/efi/morph-test}
mkdir -p "$dir"
step=$(cat "$dir/step" 2>/dev/null || echo 0)
echo "morph-test: step $step"
case "$step" in
    0)
        # An update medium, if one is attached. This step is why the flow is real:
        # without it the trial below booted whatever was ALREADY in slot B — and every
        # image we build makes both slots from one image, so it trialled a copy of the
        # system it was already running. Nothing was ever updated, and the test could
        # not tell the difference.
        #
        # The medium is a second disk the harness attaches read-only; if it is absent
        # (every other scenario) this block does nothing and those scenarios are
        # unchanged.
        medium=${MORPH_TEST_PAYLOAD:-/dev/vdb}
        if [ -b "$medium" ]; then
            mkdir -p /mnt/update
            # ⚠️ EVERY FAILURE HERE IS REPORTED AND STEPPED OVER, NOT RAISED. This
            # script runs under `set -e`, and under `set -e` a failed mount ended the
            # script — so the driver never reached the poweroff at the end, the VM sat
            # until the harness timeout, and the run said nothing except "the VM did not
            # power off". The first version of this took 20+ minutes to tell us nothing.
            # A test that cannot fail fast cannot fail informatively: say what went
            # wrong, carry on, and let the assertion at the end be the verdict.
            if mount -o ro "$medium" /mnt/update; then
                echo "morph-test: installing the payload from $medium into the inactive slot"
                # Bounded, so a slow or stuck install cannot stall the machine until the
                # harness gives up — the test must always reach its own verdict.
                if timeout 600 /mnt/update/morph-update --esp /efi --root /dev/vda3 \
                    --payload /mnt/update/payload install
                then
                    echo "morph-test: morph-update reported success"
                else
                    echo "morph-test: MORPH-UPDATE FAILED (exit $?) — slot b is unchanged"
                fi
                umount /mnt/update
            else
                echo "morph-test: COULD NOT MOUNT the update medium $medium (exit $?)"
            fi
        else
            echo "morph-test: no update medium at $medium; trialling whatever slot b holds"
        fi
        echo 1 > "$dir/step"; sync
        echo "morph-test: arming trial of slot b"
        morph-boot trial b --reboot
        ;;
    1)
        echo 2 > "$dir/step"; sync
        echo "morph-test: plain reboot"
        systemctl reboot
        ;;
    *)
        status=$(morph-boot status)
        echo "morph-test: done $status"
        if [ -n "${MORPH_TEST_EXPECT:-}" ]; then
            case "$status" in
                *"\"default\":\"$MORPH_TEST_EXPECT\""*)
                    echo "morph-test: MORPHEOS SELF-TEST PASS (default slot is $MORPH_TEST_EXPECT)" ;;
                *)
                    echo "morph-test: MORPHEOS SELF-TEST FAIL (expected default slot $MORPH_TEST_EXPECT; see: journalctl -u morph-boot-check)" ;;
            esac
        fi
        [ "${MORPH_TEST_FINISH:-poweroff}" = poweroff ] && systemctl poweroff
        ;;
esac
