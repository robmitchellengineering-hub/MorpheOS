# MorpheOS kernel — arm (armv6): the Raspberry Pi Zero.
#
# The smallest machine we claim. 32-bit, no PCI, no UEFI — it boots a kernel image plus a device tree from
# the boot partition, so this file is deliberately small: BCM2835, SD card, USB (via the on-board hub on a
# Zero), and the wireless on a Zero W. If MorpheOS runs here, the "runs on everything" claim has a floor
# that is actually low.

CONFIG_ARM=y
CONFIG_CPU_V6=y
CONFIG_MMU=y
CONFIG_ARCH_BCM2835=y
CONFIG_VFP=y
CONFIG_NEON=n

# --- storage: SD card, plus ext4 root ---
CONFIG_MMC=y
CONFIG_MMC_SDHOST=y
CONFIG_MMC_BCM2835=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_EFI_PARTITION=y

# --- a Zero has USB (through the on-board hub) and wireless on the W ---
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC2=y
CONFIG_USB_STORAGE=y
CONFIG_BRCMFMAC=m

# --- video and audio are minimal here: a Zero is a 512 MB, single-core machine ---
CONFIG_DRM=y
CONFIG_DRM_VC4=m
CONFIG_SND=y
CONFIG_SND_BCM2835_SOC_I2S=m

CONFIG_SMP=n
CONFIG_VMSPLIT_3G=y
