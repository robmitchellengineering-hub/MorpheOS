# MorpheOS kernel — arm64: Raspberry Pi 3/4/5, arm64 servers, and QEMU virt.
#
# UEFI is real on all of these (the Pi 3+ ships UEFI firmware), so the same boot path the laptop uses works
# here: our stub, our entries, no initramfs for the storage path.

CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_PAGE_SIZE_4KB=y

# --- storage, built in ---
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_SCSI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_STORAGE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_EFI_PARTITION=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y

# --- the Pi's, and the servers' ---
CONFIG_ARCH_BCM2835=y
CONFIG_DRM=y
CONFIG_DRM_V3D=m
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m
CONFIG_BRCMFMAC=m
CONFIG_SMP=y
CONFIG_NR_CPUS=256
CONFIG_NUMA=y
CONFIG_HUGETLBFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_PCI_MSI=y
CONFIG_ACPI=y
CONFIG_SCHED_AUTOGROUP=y
