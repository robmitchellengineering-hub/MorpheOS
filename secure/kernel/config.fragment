# MorpheOS kernel configuration — Phase 0 of PLAN-morpheos-own-kernel.
#
# NOT a defconfig: this is merged ON TOP of a minimal one, so every line here is a decision. The rule is
# that the machine builds only what it uses — a subsystem that is not compiled cannot be an attack surface
# — and that the things we have measured ourselves needing are present, because a missing driver is a
# dark screen rather than an error.
#
# Measured needs, from the one machine that runs this (MacBookPro9,1, 2026-10-30/31):
#   Wi-Fi     BCM4331 -> b43 (SSB), plus the firmware packages the image installs
#   GPU       Intel HD 4000 -> i915; the NVIDIA GT 650M stays on its own module and may be absent
#   Audio     CS4206 analog -> snd-hda-intel (the boot sound is ALSA, measured)
#   Storage   USB stick -> xhci_hcd + usb-storage; ext4 slots; vfat ESP
#   Boot      EFI stub + systemd-boot on the ESP; no initramfs in Phase 1

CONFIG_LOCALVERSION="-morpheos"
CONFIG_DEFAULT_HOSTNAME="morpheos"

# --- boot ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS=y

# --- the filesystems this machine actually has ---
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# --- the drivers it actually has ---
CONFIG_B43=m
CONFIG_B43_SSB=m
CONFIG_SSB=m
CONFIG_I915=m
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_USB_AUDIO=m
CONFIG_XHCI_HCD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_XHCI_HCD=m

# --- things our own userland uses, and cannot be written without ---
CONFIG_IO_URING=y
CONFIG_USERFAULTFD=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_LSM=y

# --- hardening: the kernel security project set, applied to this machine ---
CONFIG_RANDOMIZE_BASE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_PAGE_TABLE_ISOLATION=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LSM="lockdown,bpf,yama,landlock,integrity"
CONFIG_IMA=y
CONFIG_IMA_MEASURE_PCR_IDX=10
CONFIG_INTEGRITY_SIGNATURE=y
CONFIG_EFI_SECURE_BOOT=y

# --- modules are signed by us, and nothing unsigned loads (Secure edition) ---
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA256=y

# --- built-in storage, so Phase 0 boots WITHOUT an initramfs ---
# A module needs an initramfs built for this exact kernel; a built-in driver needs nothing. virtio for the
# KVM test, xhci + usb-storage for the laptop's stick — and this is where Phase 1 wants to end up anyway.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_SCSI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_XHCI_HCD=y
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_STORAGE=y
CONFIG_EFI_PARTITION=y
CONFIG_DEBUG_INFO_BTF=n
