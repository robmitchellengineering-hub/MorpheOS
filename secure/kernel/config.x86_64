# MorpheOS kernel — x86_64: the 2012 laptop, and enterprise servers.
#
# The laptop is the constraint (it is the machine we can measure); the server options below are what makes
# the same build legitimate on a rack machine rather than a kit build.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_PAGE_TABLE_ISOLATION=y

# --- boot: UEFI stub, no initramfs needed for the storage path ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS=y

# --- filesystems the machine has ---
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# --- storage built in (Phase 0/1: boot without an initramfs) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_SCSI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_XHCI_HCD=y
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_STORAGE=y
CONFIG_EFI_PARTITION=y

# --- the 2012 laptop's hardware (measured) ---
CONFIG_B43=m
CONFIG_B43_SSB=m
CONFIG_SSB=m
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_USB_AUDIO=m

# --- the drivers the hardware image claims, so the claim is about THIS kernel ---
# `images/x86-qemu/build.sh` asserts that a hardware image carries a Wi-Fi, graphics, storage and input driver
# for every laptop it can be flashed on. With our kernel in slot A that assertion now reads OUR module tree,
# so a driver the image claims and we do not build is a machine that boots and cannot get online. The set is
# the image's own list, not a wish: add to both or neither.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_UAS=m
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_MT76_CORE=m
CONFIG_MT7921E=m
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_R8169=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_XE=m
CONFIG_HID_MULTITOUCH=m
CONFIG_INPUT_EVDEV=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- enterprise servers: scale, not a different operating system ---
CONFIG_SMP=y
CONFIG_NR_CPUS=512
CONFIG_NUMA=y
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_X86_MCE=y
CONFIG_PCI_MSI=y
CONFIG_VFIO=m
CONFIG_XDP_SOCKETS=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_HOTPLUG_CPU=y
